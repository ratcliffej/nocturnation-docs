  <Capability Min="0" Max="255">100 ms units (fade-in time)</Capability>
 </Channel>
 <Channel Name="Wash Release">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">100 ms units (default fade-out)</Capability>
 </Channel>
