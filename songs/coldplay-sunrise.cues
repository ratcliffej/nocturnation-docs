@artist     Coldplay
@title      Sunrise
@bpm        120
@default_fx quiet_wash 20 40 80

@palette night    #000004, #020004
@palette sunrise  #200504, #602001, #906000, #a06000, #af9170, #61afe0  

0:00    stop
0:01    HeaderText: Coldplay
0:01    BodyText: Sunrise
0:10    BodyText: 
0:10    HeaderText:
0:05    drift_wash 0 0 0 @night[0] 16b
0:20    drift_wash @night[0] @night[1] 16b
0:40    quiet_wash @night[1]
0:50    drift_wash @night[1] @sunrise[0] 16b
1:08    drift_wash @sunrise[0] @sunrise[1] 16b
1:30    drift_wash @sunrise[1] @sunrise[2] 16b
1:46    drift_wash @sunrise[2] @sunrise[3] 16b
2:02    drift_wash @sunrise[3] @sunrise[4] 16b
2:18    drift_wash @sunrise[4] @sunrise[5] 4b
2:23    quiet_wash @sunrise[5]
2:26    fade_to_black 5
