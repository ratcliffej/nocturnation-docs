# Internal working docs - Notion is the master copy for these; the public
# mirror does not carry per-Epic plans and close-outs.
epics/
manuals/notes.md

# Cue files are the author's active bench working copy - not tracked in
# GitHub so no git operation (checkout / stash / pop / reset) can
# clobber in-progress edits. Backup discipline lives on the author's
# laptop.
songs/*.cues

# Audio masters used for local librosa enrichment (audio_enrich_cues.py)
# - never tracked. Large binaries and the Docs mirror is public.
songs/*.flac
songs/*.wav
songs/*.mp3
songs/*.m4a
songs/*.ogg
songs/*.aiff
songs/*.aif

# Sidecars produced by audio_enrich_cues.py alongside the .cues file.
songs/*.cues.analysis.json
songs/*.cues.bak

# macOS noise
.DS_Store

# Python shim artefacts (tools/) - venv + bytecode cache, never tracked
tools/.venv/
__pycache__/
*.pyc
